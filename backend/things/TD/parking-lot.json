      "uiType": "NumberCardHTTP",
      "observable": false,
      "readOnly": true,
      "forms": [
        {
          "href": "http://localhost:3000/api/v1/proxy/things/urn:platform:thing:parking-lot/properties/remainingSpaces",
          "contentType": "application/json",
          "op": [
            "readproperty"
          ]
        }
      ]
    }
  }
}